{
  "name": "honeymoonshop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3300",
    "build": "node scripts/prisma.mjs generate && next build && node scripts/seo-check.mjs",
    "start": "next start -p 3300",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/prisma.mjs generate",
    "prisma": "node scripts/prisma.mjs",
    "db:push": "node scripts/prisma.mjs db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:export": "node scripts/export-db.mjs",
    "setup": "npm run db:push && npm run db:seed",
    "scrape": "node scripts/scrape.mjs",
    "images": "node scripts/download-images.mjs",
    "seo:check": "node scripts/seo-check.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^3.0.2",
    "jose": "^6.1.0",
    "next": "^15.5.28",
    "react": "^19.1.10",
    "react-dom": "^19.1.10",
    "sanitize-html": "^2.17.0",
    "sharp": "^0.34.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.0",
    "cheerio": "^1.1.2",
    "prisma": "^6.16.2",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5"
  }
}
